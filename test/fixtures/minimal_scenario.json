  "rules": {
    "firstNightKill": false, "showTeamAtStart": true, "deadCanSpeak": false,
    "lastWords": { "enabled": true, "seconds": 30 },
    "vote": { "mode": "majority", "tieBreak": "revote", "abstain": true,
