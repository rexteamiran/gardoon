    "doctor": { "selfSave": true, "sameTargetTwice": true },
    "audio": { "phaseChange": true, "death": "builtin:gunshot" }
  },
  "winConditions": [
    { "team": "city",  "join": "AND",
      "terms": [ { "left": "aliveCount:mafia", "op": "==", "right": "0" } ] },
    { "team": "mafia", "join": "AND",
      "terms": [ { "left": "aliveCount:mafia", "op": ">=", "right": "aliveCount:city" } ] }
  ],
  "events": []
